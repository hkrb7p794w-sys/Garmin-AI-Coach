{%- set ns = namespace(s=RAW) -%}
{%- for o in [-4, -2, 0, 1, 2, 3, 4, 5, 6] -%}{%- set ns.s = ns.s.replace('§S' ~ ('+' if o > 0 else '') ~ o ~ '§', _mmss(css + o)) -%}{%- endfor -%}
{%- for w in [100, 65, 68, 70, 72, 75, 77, 78, 80, 88, 90, 92, 94, 95, 98, 105, 110, 115] -%}{%- set ns.s = ns.s.replace('§W' ~ w ~ '§', ((ftp * w / 100) | round(0) | int) | string) -%}{%- endfor -%}
{%- set ns.s = ns.s.replace('§T§', _mmss(t)).replace('§I§', _mmss(t - 23) ~ '–' ~ _mmss(t - 18)).replace('§E§', _mmss(t + 65) ~ '–' ~ _mmss(t + 100)).replace('§MP§', _mmss(mp)).replace('§R§', _mmss(rp)) -%}
{#- Wettkampfspezifische Laufeinheiten (seit 21.10.2026, Felder qw/lw aus scripts/gen_run_plan.py): Alex nimmt sie im
    Reiter Chat einzeln an oder lehnt sie ab (Add-on: Vorschlags-Quelle "wettkampf", ids wk-lauf-<Montag>-q / -l).
    Abgelehnt -> Alternative (qa/qca bzw. la), angenommen -> bleibt, ohne Entscheidung -> bleibt, als offen markiert. -#}
{%- set P = ns.s | from_json -%}
{%- set dec = state_attr('sensor.garmin_ai_coach_garmin_vorschlaege', 'wettkampf') or {} -%}
{%- set out = namespace(w=[]) -%}
{%- for x in P.weeks -%}
{%- set y = x -%}
{%- if x.qw is defined -%}
{%- set st = dec.get('wk-lauf-' ~ x.w ~ '-q', 'offen') -%}
{%- if st == 'rejected' -%}{%- set y = dict(y, q=x.qa, qc=x.qca, qs='abgelehnt', qw_orig=x.qc) -%}
{%- else -%}{%- set y = dict(y, qc='🏁 ' ~ x.qc, qs=('angenommen' if st == 'accepted' else 'offen')) -%}{%- endif -%}
{%- endif -%}
{%- if x.lw is defined -%}
{%- set st = dec.get('wk-lauf-' ~ x.w ~ '-l', 'offen') -%}
{%- if st == 'rejected' -%}{%- set y = dict(y, l=x.la, ls='abgelehnt') -%}
{%- else -%}{%- set y = dict(y, l='🏁 ' ~ x.l, ls=('angenommen' if st == 'accepted' else 'offen')) -%}{%- endif -%}
{%- endif -%}
{%- set out.w = out.w + [y] -%}
{%- endfor -%}
{{- dict(P, weeks=out.w) | to_json -}}
{%- endmacro -%}
